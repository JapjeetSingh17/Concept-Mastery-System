# ==============================================================================
# Closed-Loop Concept Mastery Platform - Environment Configuration Example
# Copy to concept-mastery/backend/.env:
#   cp concept-mastery/backend/.env.example concept-mastery/backend/.env
#
# In development/test modes the platform can run offline with heuristic fallbacks.
# In non-test/production environments, required secrets (JWT_SECRET and at least
# one LLM API key) MUST be set to strong non-placeholder values at startup.
# ==============================================================================

# ── Runtime Environment & Offline/Test Controls ────────────────────────────────
# Options: development | test | staging | production
ENVIRONMENT=development
# Set to 1 in offline test/CI runs to force deterministic heuristic LLM fallbacks
OFFLINE_TEST=0
# Set to 1 when explicitly running live OpenRouter integration tests under pytest
OPENROUTER_LIVE=0

# ── Storage & SQLite Database Paths (relative to concept-mastery/backend/) ─────
UPLOAD_DIR=../data/uploads
VECTOR_STORE_PATH=../data/vectorstore
GENERATED_ARTIFACTS_DIR=generated_artifacts

# Optional explicit SQLite DB overrides (default inside VECTOR_STORE_PATH)
SQLITE_MATERIALS_DB_PATH=
SQLITE_INDEX_DB_PATH=
SQLITE_MASTERY_DB_PATH=
# SQLite WAL lock wait timeout in milliseconds
SQLITE_BUSY_TIMEOUT_MS=10000

# ── OpenRouter Unified Gateway (Primary LLM & Model Failover) ──────────────────
# Required in production (unless a fallback LLM key below is configured)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional comma-separated failover pool (leave default unless customizing)
OPENROUTER_MODELS=google/gemini-2.5-flash,nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-chat-v3-0324:free,nvidia/nemotron-3.5-super-vl:free,meta-llama/llama-3.3-70b-instruct:free,openrouter/auto

# ── Fallback / Generic LLM Providers (Optional) ────────────────────────────────
# Google Gemini (direct fallback LLM & Tier 2 TTS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Groq Cloud (fallback LLM, Tier 3 Orpheus TTS & Whisper STT)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_STT_MODEL=whisper-large-v3-turbo

# Generic OpenAI / Anthropic-compatible provider
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ── Optional Feature Keys (Warnings logged if missing) ─────────────────────────
# ElevenLabs Flash v2.5 Text-to-Speech (optional; falls back cleanly if omitted)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# TinyFish Web Search API (optional; enrichment skipped if omitted)
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai

# PageIndex Structured PDF Hierarchy API (optional; local PyMuPDF parser used)
PAGEINDEX_API_KEY=

# ── Google OAuth 2.0 & JWT Session Security ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# REQUIRED in production: replace with a strong random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-random-32byte-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# ── Timeouts & Rate Limits ─────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=8.0
TTS_TIMEOUT_SECONDS=30.0
WEB_SEARCH_TIMEOUT_SECONDS=6.0
AGENT_TIMEOUT_SECONDS=20
LLM_RATE_LIMIT_RPM=60
API_RATE_LIMIT_RPM=120
