# ==============================================================================
# Closed-Loop Concept Mastery Platform - Environment Configuration Example
# Copy this file to .env and configure your keys.
# The platform functions offline with fallback heuristics if keys are omitted.
# ==============================================================================

# PageIndex API Key (for structured document hierarchy)
PAGEINDEX_API_KEY=

# Primary LLM: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback LLM: Groq Cloud (Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generic LLM Provider (OpenAI / Anthropic compatible)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Storage paths
UPLOAD_DIR=../data/uploads
VECTOR_STORE_PATH=../data/vectorstore
